#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    mkdir -p /var/run/udp-discovery-relay
    chmod 755 /var/run/udp-discovery-relay
    /usr/bin/udp-discovery-relay --uci --check || return 1
    procd_open_instance
    procd_set_param command /usr/bin/udp-discovery-relay --uci
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/udp_discovery_relay
    procd_set_param limits core="0 0" nofile="256 256"
    procd_close_instance
}
reload_service() {
    /usr/bin/udp-discovery-relay --uci --check || return 1
    procd_send_signal udp-discovery-relay '*' HUP
}
service_triggers() {
    procd_add_reload_trigger udp_discovery_relay
    procd_add_raw_trigger 'interface.*' 1000 /etc/init.d/udp-discovery-relay reload
}
stop_service() {
    rm -f /var/run/udp-discovery-relay/status.json /var/run/udp-discovery-relay/status.tmp
}
