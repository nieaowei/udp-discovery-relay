config global 'main'
	option enabled '1'
	option log_level 'info'
	option loop_protection '1'
	option max_packet_size '1400'

config rule 'localsend'
	option enabled '1'
	option name 'LocalSend'
	option protocol 'udp'
	option port '53317'
	option multicast '224.0.0.167'
	option direction 'bidirectional'
	option log_level 'info'
	list network 'wan'
	list network 'lan'
